# API Base URL for backend services
VITE_API_BASE_URL=https://api.gear-stack.dev-made.it/api

VITE_PORT=5177

# API Proxy URL (used by Vite dev server to proxy /api requests)
# This is useful for avoiding CORS issues during development
VITE_API_PROXY_URL=http://localhost:8007

# App Configuration
VITE_APP_ID=gear-stack
VITE_APP_NAME=Gear Stack
VITE_APP_DESCRIPTION=My application description

# Internationalization
VITE_DEFAULT_LOCALE=en
VITE_FALLBACK_LOCALE=en

# Development - Default User Credentials (for login form auto-fill in development)
# Leave empty in production!
#VITE_DEFAULT_USER_EMAIL=jan.madeyski@gmail.com
#VITE_DEFAULT_USER_PASSWORD=Secret123!

VITE_ENABLE_BACKEND=true

# Auth Routes (optional - customize if you need different route paths)
# VITE_AUTH_LOGIN_PATH=/auth/login
# VITE_AUTH_REGISTER_PATH=/auth/register
# VITE_AUTH_FORGOT_PASSWORD_PATH=/auth/forgot-password
# VITE_AUTH_RESET_PASSWORD_PATH=/auth/reset-password
# VITE_AUTH_CHANGE_PASSWORD_PATH=/auth/change-password
# VITE_AUTH_DASHBOARD_PATH=/dashboard

# OAuth (public client IDs)
VITE_GOOGLE_OAUTH_CLIENT_ID=946297486350-3e754ifbovdni5cac8eru6337mi28o8q.apps.googleusercontent.com


# ============================================================================
# Gear Stack - Backend - Environment Variables Example
# ============================================================================
# Copy this file to .env and update the values according to your environment
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_NAME=gear-stack-api
APP_DISPLAY_NAME=Gear Stack
APP_VERSION=0.1.2
DEBUG=False
ENVIRONMENT=development  # Options: local, development, test, production

# ----------------------------------------------------------------------------
# Server Settings
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=True
CORS_ORIGINS=["http://localhost:3000"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ----------------------------------------------------------------------------
# Frontend URL
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Database Settings
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# For PostgreSQL, use: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=False

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------
# IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24

# ----------------------------------------------------------------------------
# Rate Limiting Settings
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_HOUR=1000
AUTH_REGISTER_RATE_LIMIT=5/minute
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REFRESH_RATE_LIMIT=20/minute
AUTH_PASSWORD_CHANGE_RATE_LIMIT=3/minute

# ----------------------------------------------------------------------------
# Logging Settings
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=%(asctime)s | %(name)s | %(levelname)s | %(message)s
LOG_FILE=  # Optional: path to log file (leave empty for console only)

# ----------------------------------------------------------------------------
# Google reCAPTCHA v3 Settings (Optional)
# ----------------------------------------------------------------------------
RECAPTCHA_ENABLED=False
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# ----------------------------------------------------------------------------
# OAuth Settings (Optional)
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ----------------------------------------------------------------------------
# Email Settings
# ----------------------------------------------------------------------------
EMAIL_ENABLED=True
EMAIL_ADAPTER=file  # Options: file, smtp
EMAIL_FILE_PATH=./emails

# SMTP Settings (required if EMAIL_ADAPTER=smtp)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=True
EMAIL_ENABLE_AUDIT=True
EMAIL_ENABLE_RETRY=False
EMAIL_MAX_RETRIES=5

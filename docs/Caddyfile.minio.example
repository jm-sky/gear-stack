# Example Caddyfile configuration for Gear Stack with MinIO
# Place this file in /etc/caddy/Caddyfile or your Caddy configuration directory
# Adjust domain names and paths according to your setup

# Main application
gear-stack.ovh {
  root * /var/www/gear-stack

  # Enable gzip compression
  encode gzip zstd

  # Static assets with long-term cache (hashed filenames)
  @hashed_assets {
      path /assets/*.js
      path /assets/*.css
      path /assets/*.woff2
      path /assets/*.woff
      path /assets/*.ttf
      path /assets/*.eot
      path /webfonts/*
  }

  # HTML files should not be cached
  @html_files {
      path /*.html
      path /
  }

  # Other static assets (shorter cache)
  @static_assets {
      path /favicon.ico
      path /robots.txt
      path /*.png
      path /*.jpg
      path /*.jpeg
      path /*.gif
      path /*.svg
      path /*.ico
  }

  # Apply cache headers
  header @hashed_assets {
      Cache-Control "public, max-age=31536000, immutable"
  }

  header @html_files {
      Cache-Control "no-cache, no-store, must-revalidate"
      Pragma "no-cache"
      Expires "0"
  }

  header @static_assets {
      Cache-Control "public, max-age=3600"
  }

  # API routes - proxy to FastAPI backend
  handle /api/* {
      reverse_proxy localhost:8000 {
          header_up X-Real-IP {remote_host}
          header_up X-Forwarded-For {remote_host}
          header_up X-Forwarded-Proto {scheme}
      }
  }

  # Serve static files for all other routes
  file_server

  # Fallback to index.html for SPA routing
  try_files {path} /index.html
}

# MinIO API (S3 endpoint) - s3.gear-stack.ovh
s3.gear-stack.ovh {
  reverse_proxy localhost:9002 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# MinIO Console (Admin UI) - minio.gear-stack.ovh
minio.gear-stack.ovh {
  reverse_proxy localhost:9003 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}


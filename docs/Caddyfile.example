# Example Caddyfile configuration for Gear Stack
# Place this file in /etc/caddy/Caddyfile or your Caddy configuration directory
# Adjust domain names and paths according to your setup

gear-stack.ovh {
  # Root directory where static files are served from
  root * /var/www/gear-stack

  # Enable gzip compression
  encode gzip zstd

  # Static assets with long-term cache (hashed filenames)
  # These files have hashes in their names (e.g., index-CZGLpK2X.js)
  # Safe to cache for 1 year because filename changes when content changes
  @hashed_assets {
      path /assets/*.js
      path /assets/*.css
      path /assets/*.woff2
      path /assets/*.woff
      path /assets/*.ttf
      path /assets/*.eot
      path /webfonts/*
  }
  header @hashed_assets {
      Cache-Control "public, max-age=31536000, immutable"
  }

  # Other static assets (shorter cache)
  @static_assets {
      path /assets/*
      path /favicon.ico
      path /robots.txt
      path /*.png
      path /*.jpg
      path /*.jpeg
      path /*.gif
      path /*.svg
      path /*.ico
  }
  header @static_assets {
      Cache-Control "public, max-age=3600"
  }

  # HTML files should not be cached (or very short cache)
  # This ensures users always get the latest index.html
  @html_files {
      path /*.html
      path /
  }
  header @html_files {
      Cache-Control "no-cache, no-store, must-revalidate"
      Pragma "no-cache"
      Expires "0"
  }

  # API routes - proxy to FastAPI backend
  handle /api/* {
      reverse_proxy localhost:8000 {
          # Optional: add headers for backend
          header_up X-Real-IP {remote_host}
          header_up X-Forwarded-For {remote_host}
          header_up X-Forwarded-Proto {scheme}
      }
  }

  # Serve static files for all other routes
  file_server

  # Fallback to index.html for SPA routing
  try_files {path} /index.html
}

